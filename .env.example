# Docker Compose / InfluxDB bootstrap (development values only; replace outside demos)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-this-admin-password
INFLUX_TOKEN=change-this-to-a-long-random-influx-token
INFLUX_ORG=iot
INFLUX_BUCKET=iot_monitoring
INFLUX_RETENTION=0

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# MQTT consumed by the containerized backend
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=iot/monitoring/+/vitals
MQTT_CLIENT_ID=iot-monitoring-backend

# SMTP (notifications stay disabled while SMTP_HOST or ALERT_EMAIL_TO is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
SEND_RECOVERY_EMAIL=true

LOG_LEVEL=info
