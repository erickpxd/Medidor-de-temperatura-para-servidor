# The root .env.example is the canonical configuration for Docker Compose.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=iot/monitoring/+/vitals
MQTT_CLIENT_ID=iot-monitoring-backend

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=replace-with-a-long-random-token
INFLUX_ORG=iot
INFLUX_BUCKET=iot_monitoring

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
SEND_RECOVERY_EMAIL=true
LOG_LEVEL=info
